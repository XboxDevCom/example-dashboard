<Page
    x:Class="Dashboard.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dashboard.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseSystemFocusVisuals="True"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <ScrollViewer>
            <StackPanel Spacing="24" MaxWidth="600">

                <TextBlock Text="Einstellungen"
                           FontSize="32"
                           FontWeight="Bold"/>

                <StackPanel Spacing="12">
                    <TextBlock Text="Allgemein" FontSize="22" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="DarkModeToggle"
                                  Header="Dunkler Modus"
                                  Toggled="DarkModeToggle_Toggled"
                                  MinHeight="48"/>
                    <ToggleSwitch x:Name="SoundToggle"
                                  Header="UI-Sounds"
                                  Toggled="SoundToggle_Toggled"
                                  IsOn="True"
                                  MinHeight="48"/>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Anzeige" FontSize="22" FontWeight="SemiBold"/>
                    <Slider x:Name="FontSizeSlider"
                            Header="Schriftgröße"
                            Minimum="14"
                            Maximum="24"
                            Value="18"
                            StepFrequency="1"/>
                    <ComboBox x:Name="LanguageCombo"
                              Header="Sprache"
                              SelectedIndex="0"
                              MinHeight="48">
                        <ComboBoxItem Content="Deutsch"/>
                        <ComboBoxItem Content="Englisch"/>
                        <ComboBoxItem Content="Französisch"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Über" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Version 1.0.0.0" FontSize="16"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
