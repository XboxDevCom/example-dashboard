<Page
    x:Class="Dashboard.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dashboard.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseSystemFocusVisuals="True"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <ScrollViewer>
            <StackPanel Spacing="24">
                <TextBlock Text="Statistiken"
                           FontSize="32"
                           FontWeight="Bold"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0"
                            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,12,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Nutzungszeit" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="24 Stunden" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1"
                            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="8"
                            Padding="20"
                            Margin="12,0,0,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Apps geöffnet" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="1.247" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0"
                            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,12,12,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Spiele gespielt" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="89" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1"
                            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="8"
                            Padding="20"
                            Margin="12,12,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Erfolge" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="342" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Button Content="Zurücksetzen"
                        MinHeight="48"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
